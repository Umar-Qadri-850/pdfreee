# Public origin used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
# Used both by the Vite build (import.meta.env.VITE_SITE_URL) and the
# build-time SEO generator (scripts/generate-seo.ts).
#
# Examples:
#   Local dev / preview:  http://localhost:5173
#   Docker compose:       http://localhost:8080
#   Production:           https://pdfreee.app
VITE_SITE_URL=https://pdfreee.app
