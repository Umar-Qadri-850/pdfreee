# Public origin used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
# Used both by the Vite build (import.meta.env.VITE_SITE_URL) and the
# build-time SEO generator (scripts/generate-seo.ts).
#
# Examples:
#   Local dev / preview:  http://localhost:5173
#   Docker compose:       http://localhost:8080
#   Production:           https://pdfreee.app
VITE_SITE_URL=https://pdfreee.app

# --- Optional advertising (Google AdSense) -----------------------------------
# Advertising is disabled unless you set VITE_ADSENSE_ENABLED=true AND supply a
# real publisher ID and numeric slot IDs below. The app renders no ad markup and
# loads no ad script until a visitor has also consented via the cookie banner.
#
# IMPORTANT: if you enable ads, you MUST also allow Google's origins in the
# Content-Security-Policy in nginx.conf (script-src, connect-src, frame-src, and
# img-src as needed) or the ad script will be blocked. See DEPLOYMENT.md.
#
# VITE_ADSENSE_ENABLED=false
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT_TOP=0000000000
# VITE_ADSENSE_SLOT_BOTTOM=0000000000
